rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bloovalk@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'settings']) &&
             data.keys().size() == 6 &&
             data.uid == request.auth.uid &&
             data.email == request.auth.token.email &&
             data.displayName is string &&
             data.displayName.size() <= 100 &&
             data.photoURL is string &&
             data.photoURL.size() <= 500 &&
             data.createdAt == request.time &&
             data.settings is map;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt']) &&
             // isPinned is optional but let's check keys carefully
             (data.keys().size() == 4 || (data.keys().size() == 5 && data.keys().hasAll(['isPinned']))) &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 200 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'timestamp']) &&
             (data.keys().size() == 3 || data.keys().hasAll(['image', 'fileName'])) &&
             data.role in ['user', 'model'] &&
             data.content is string &&
             data.content.size() <= 10000 &&
             data.timestamp == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) && isEmailVerified() && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'settings']) &&
         incoming().displayName is string && incoming().displayName.size() <= 100 &&
         incoming().photoURL is string && incoming().photoURL.size() <= 500 &&
         incoming().settings is map)
      );
    }

    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(chatId) && isEmailVerified() && isValidChat(incoming());
      allow update: if isValidId(chatId) && isEmailVerified() && existing().userId == request.auth.uid && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt', 'isPinned']) &&
         incoming().title is string && incoming().title.size() <= 200 &&
         incoming().updatedAt == request.time)
      );
      allow delete: if isValidId(chatId) && isEmailVerified() && (existing().userId == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        // Master Gate: Check parent chat ownership
        function getChatOwner() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.userId;
        }

        allow get: if isValidId(messageId) && isSignedIn() && (getChatOwner() == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (getChatOwner() == request.auth.uid || isAdmin());
        allow create: if isValidId(messageId) && isEmailVerified() && getChatOwner() == request.auth.uid && isValidMessage(incoming());
        allow update: if false; // Messages are usually immutable in this app
        allow delete: if isValidId(messageId) && isEmailVerified() && (getChatOwner() == request.auth.uid || isAdmin());
      }
    }
    
    // Connectivity check entry
    match /_health_/check {
      allow read: if true;
    }
  }
}
